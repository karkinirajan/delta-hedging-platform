# Copy to .env (never commit it) and fill in your own values. Every value below is a demo.

# --- IG demo account (https://labs.ig.com/) ---
# Only IG's DEMO environment is supported. A key is created in the IG dashboard for a demo account.
IG_API_KEY=your-ig-api-key
IG_USERNAME=your-ig-demo-username
IG_PASSWORD=your-ig-demo-password
# The two accounts: the options are read from the first, the hedges are placed on the second (account ids, e.g. ABC123)
IG_OPTIONS_ACCOUNT=your-options-account-id
IG_CFD_ACCOUNT=your-cfd-account-id
# The instrument the hedges are placed in (IG epic of the underlying), e.g. the S&P 500 index CFD of the demo
IG_UNDERLYING_EPIC=IX.D.SPTRD.IFS.IP

# --- The web app ---
# Callers of /api must send "Authorization: Bearer <this>". At least 24 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me-to-a-long-random-token
# false: the API only shows what it would do (a dry run). true: an order is placed when a request confirms it.
HEDGING_ENABLED=false

# --- Hedging rules (all optional) ---
# Currency of the orders
ORDER_CURRENCY=GBP
# Net delta, in units of the underlying, that is left alone
DELTA_THRESHOLD=0.05
# Smallest and largest order; a larger need is hedged in steps
MIN_HEDGE_SIZE=0.01
MAX_HEDGE_SIZE=100
# How far the order size may move between the preview and the confirmed order, as a fraction (0.05 = 5 %)
PLAN_TOLERANCE=0.05
# Seconds between two orders
COOLDOWN_SECONDS=60

# --- The model (all optional) ---
RISK_FREE_RATE=0.05
# Used, and labelled as such, when no implied volatility can be found for a position
DEFAULT_VOLATILITY=0.2
MIN_VOLATILITY=0.001
MAX_VOLATILITY=2.0

# --- Other (all optional) ---
# Seconds an answer of IG is kept, and the timeout of a request to IG
MARKET_DATA_TTL=5
REQUEST_TIMEOUT=30
# Only for tests and local fakes
IG_BASE_URL=
IG_ENVIRONMENT=demo
